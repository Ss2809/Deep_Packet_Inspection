{
  "name": "deep-packet-inspection-node",
  "version": "2.0.0",
  "description": "Production-ready Node.js + Express deep packet inspection service converted from the original C++ packet analyzer.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "cli": "node src/cli/analyze.js",
